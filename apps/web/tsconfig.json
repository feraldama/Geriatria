{
  // Hereda la configuración estricta compartida (noUncheckedIndexedAccess,
  // noUnusedLocals, etc.): el frontend indexa arrays de respuestas de escalas,
  // justo donde esas comprobaciones más valen.
  "extends": "@geriatria/config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "ES2022"],
    "allowJs": true,
    "noEmit": true,
    "declaration": false,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
