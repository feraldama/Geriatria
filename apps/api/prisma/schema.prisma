// Esquema de base de datos (Prisma + PostgreSQL).
//
// Fase 0: modelos de autenticación y RBAC (User, Role, Permission) + AuditLog.
// Los modelos clínicos (Patient, Consultation, etc.) se agregan en fases
// siguientes. Todos los registros llevan createdAt/updatedAt/deletedAt
// (borrado lógico) y createdById donde aplica.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// RBAC: usuarios, roles y permisos
// ─────────────────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  photoUrl     String?
  active       Boolean   @default(true)
  // Preferencias de interfaz (tamaño de fuente, etc.) como JSON flexible.
  preferences  Json      @default("{}")

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  // Protección contra fuerza bruta: contador de intentos fallidos y bloqueo.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?

  // Se incrementa al cambiar/restablecer la contraseña: invalida los JWT
  // emitidos antes (el token lleva la versión y se compara en cada request).
  tokenVersion Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdById String?
  createdBy   User?   @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers User[] @relation("UserCreatedBy")

  // Autoría de los registros clínicos: relaciones reales (no ids sueltos), para
  // que el "quién lo registró" tenga integridad referencial.
  createdPatients            Patient[]              @relation("PatientCreatedBy")
  createdAppointments        Appointment[]          @relation("AppointmentCreatedBy")
  createdConsultations       Consultation[]         @relation("ConsultationCreatedBy")
  editedConsultationRevs     ConsultationRevision[] @relation("ConsultationRevisionEditedBy")
  createdVitalSigns          VitalSign[]            @relation("VitalSignCreatedBy")
  createdMedications         Medication[]           @relation("MedicationCreatedBy")
  createdDocuments           Document[]             @relation("DocumentCreatedBy")
  createdScales              AssessmentScale[]      @relation("AssessmentScaleCreatedBy")
  createdSyndromeAssessments SyndromeAssessment[]   @relation("SyndromeAssessmentCreatedBy")
  createdLanguageAssessments LanguageAssessment[]   @relation("LanguageAssessmentCreatedBy")
  createdVaccinations        Vaccination[]          @relation("VaccinationCreatedBy")
  createdCarePlans           CarePlan[]             @relation("CarePlanCreatedBy")

  auditLogs AuditLog[]

  @@index([email])
  @@index([deletedAt])
}

model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  // Roles base del sistema (no se pueden borrar; sí editar permisos).
  isSystem    Boolean @default(false)

  permissions RolePermission[]
  users       User[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Permission {
  id          String  @id @default(cuid())
  // Acción en formato `recurso:acción`, ej. "patient:read".
  action      String  @unique
  description String

  roles RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// Tabla puente N–N entre Role y Permission (permisos editables sin tocar código).
model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// ─────────────────────────────────────────────────────────────────────────
// Pacientes (Fase 1)
// ─────────────────────────────────────────────────────────────────────────

enum Sex {
  MASCULINO
  FEMENINO
  OTRO
}

enum MaritalStatus {
  SOLTERO
  CASADO
  VIUDO
  DIVORCIADO
  UNION_LIBRE
  OTRO
}

// Nivel de dependencia para actividades de la vida diaria.
enum DependencyLevel {
  INDEPENDIENTE
  LEVE
  MODERADA
  SEVERA
  TOTAL
}

// Estado de un hábito (tabaco / alcohol).
enum HabitStatus {
  NUNCA
  EX
  ACTIVO
}

enum EducationLevel {
  NINGUNA
  PRIMARIA
  SECUNDARIA
  TERCIARIA
  UNIVERSITARIA
}

enum ExerciseLevel {
  SEDENTARIO
  OCASIONAL
  REGULAR
}

enum AllergySeverity {
  LEVE
  MODERADA
  SEVERA
}

enum AppointmentType {
  PRIMERA_VEZ
  CONTROL
  DOMICILIARIA
  TELECONSULTA
}

enum MedicationRoute {
  ORAL
  SUBLINGUAL
  INTRAVENOSA
  INTRAMUSCULAR
  SUBCUTANEA
  TOPICA
  INHALATORIA
  OFTALMICA
  OTICA
  RECTAL
  OTRA
}

enum MedicationStatus {
  ACTIVA
  SUSPENDIDA
}

enum DocumentCategory {
  LABORATORIO
  IMAGEN
  INTERCONSULTA
  ELECTROCARDIOGRAMA
  OTRO
}

enum AppointmentStatus {
  PROGRAMADA
  CONFIRMADA
  ATENDIDA
  AUSENTE
  CANCELADA
}

model Patient {
  id String @id @default(cuid())

  // Datos personales
  firstName  String
  lastName   String
  documentId String? // documento de identidad (cédula); puede faltar al alta

  // Texto de búsqueda normalizado (minúsculas y sin acentos) = nombre +
  // apellido + documento. Permite buscar "gonzalez" y encontrar "González".
  // Se mantiene en cada alta/edición desde la capa de aplicación.
  searchText String @default("")
  birthDate  DateTime
  sex        Sex
  maritalStatus MaritalStatus?
  photoUrl   String?

  // Datos sociodemográficos
  birthPlace     String? // lugar de nacimiento
  education      EducationLevel?
  educationYears Int? // años de estudio (ajuste de escalas cognitivas)
  occupation     String?

  // Contacto
  address  String?
  phone    String?
  phoneAlt String?
  email    String?

  // Contacto de emergencia
  emergencyName     String?
  emergencyPhone    String?
  emergencyRelation String?

  // Seguro / obra social / previsión
  insuranceProvider String?
  insuranceNumber   String?

  // Situación social
  livesWith        String? // con quién vive
  dependencyLevel  DependencyLevel?
  housingSituation String?

  // Antecedentes
  medicalHistory   String? @db.Text // patológicos
  surgicalHistory  String? @db.Text
  familyHistory    String? @db.Text
  smoking          HabitStatus?
  alcohol          HabitStatus?
  physicalExercise ExerciseLevel?
  habitsNotes      String?
  notes            String? @db.Text

  // Relaciones
  caregivers    Caregiver[]
  conditions    Condition[]
  allergies     Allergy[]
  appointments  Appointment[]
  consultations Consultation[]
  vitalSigns    VitalSign[]
  medications   Medication[]
  documents     Document[]
  scales        AssessmentScale[]
  vaccinations  Vaccination[]
  syndromeAssessments SyndromeAssessment[]
  languageAssessments LanguageAssessment[]
  carePlan      CarePlan?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdById String?
  createdBy   User?   @relation("PatientCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  // El listado siempre filtra por deletedAt y ordena por apellido/nombre.
  @@index([deletedAt, lastName, firstName])
  @@index([documentId])
  // ⚠️  Hay índices que Prisma no puede expresar y viven solo en SQL:
  //   · Patient_searchText_trgm_idx  (GIN/pg_trgm; searchText se busca con LIKE '%…%')
  //   · Patient_documentId_active_key (único parcial sobre pacientes vigentes)
  //   · User_name_trgm_idx / User_email_trgm_idx
  // Están en la migración 20260806000000_hardening_auditoria_indices. Prisma los
  // ve como "de más" y un `prisma migrate dev` genera una migración que los
  // ELIMINA: si eso pasa, borrá esos DROP INDEX del SQL antes de aplicarlo.
  // Hay un test que lo verifica (src/prisma-indexes.test.ts).
}

// Cuidador / red de apoyo (clave en geriatría). Un paciente puede tener varios.
model Caregiver {
  id           String  @id @default(cuid())
  patientId    String
  patient      Patient @relation(fields: [patientId], references: [id])
  name         String
  relationship String? // parentesco
  phone        String?
  livesWith    Boolean @default(false) // ¿convive con el paciente?
  isPrimary    Boolean @default(false) // ¿cuidador principal?
  notes        String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([patientId, deletedAt])
}

// Condición crónica / comorbilidad.
model Condition {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id])
  name      String
  since     DateTime? // desde cuándo (aproximado)
  active    Boolean  @default(true)
  notes     String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([patientId, deletedAt])
}

// Alergia. Siempre se resalta en rojo en la interfaz.
// Nunca se borra físicamente: saber cuándo se quitó una alergia es un dato de
// seguridad del paciente.
model Allergy {
  id        String           @id @default(cuid())
  patientId String
  patient   Patient          @relation(fields: [patientId], references: [id])
  substance String // sustancia / fármaco
  reaction  String?
  severity  AllergySeverity?
  notes     String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([patientId, deletedAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Agenda / Citas (Fase 2)
// ─────────────────────────────────────────────────────────────────────────

model Appointment {
  id String @id @default(cuid())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  scheduledAt DateTime // fecha y hora de inicio (UTC)
  durationMin Int      @default(30)
  reason      String? // motivo de consulta
  type        AppointmentType   @default(CONTROL)
  status      AppointmentStatus @default(PROGRAMADA)
  notes       String?           @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdById String?
  createdBy   User?   @relation("AppointmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  // Una cita puede tener (opcionalmente) su consulta asociada (1–1).
  consultation Consultation?

  // La agenda consulta por rango de fechas sobre las citas vigentes.
  @@index([deletedAt, scheduledAt])
  @@index([patientId, deletedAt, scheduledAt])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────
// Consultas (historia clínica) y signos vitales (Fase 3)
// ─────────────────────────────────────────────────────────────────────────

// Consulta en formato SOAP (Subjetivo, Objetivo, Análisis, Plan).
model Consultation {
  id String @id @default(cuid())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  // Vínculo opcional 1–1 con la cita que originó la consulta.
  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  date       DateTime @default(now())
  subjective String?  @db.Text // S: relato del paciente
  objective  String?  @db.Text // O: examen / hallazgos (texto libre)
  assessment String?  @db.Text // A: análisis / evaluación
  plan       String?  @db.Text // P: plan / indicaciones

  // Examen físico/neurológico estructurado: { campoId: texto }.
  physicalExam Json?

  vitalSigns VitalSign[]

  // Historial de versiones: cada edición archiva el estado anterior.
  revisions ConsultationRevision[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  createdBy   User?     @relation("ConsultationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([patientId, deletedAt, date])
  @@index([createdById])
}

// Copia inmutable del estado previo de una consulta antes de cada edición.
// La historia clínica no se sobrescribe: se versiona.
model ConsultationRevision {
  id String @id @default(cuid())

  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id])

  // Estado ANTERIOR a la edición que originó esta revisión.
  date         DateTime
  subjective   String?  @db.Text
  objective    String?  @db.Text
  assessment   String?  @db.Text
  plan         String?  @db.Text
  physicalExam Json?

  // Quién hizo la edición y cuándo.
  editedAt   DateTime @default(now())
  editedById String?
  editedBy   User?    @relation("ConsultationRevisionEditedBy", fields: [editedById], references: [id], onDelete: Restrict)

  @@index([consultationId, editedAt])
}

// Registro de signos vitales (con seguimiento en el tiempo).
model VitalSign {
  id String @id @default(cuid())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  consultationId String?
  consultation   Consultation? @relation(fields: [consultationId], references: [id])

  // Medidas clínicas en Decimal (no Float): se comparan y grafican, y el
  // redondeo binario introduciría ruido en las curvas de peso/IMC.
  measuredAt        DateTime @default(now())
  systolic          Int? // PA sistólica (mmHg)
  diastolic         Int? // PA diastólica (mmHg)
  heartRate         Int? // FC (lpm)
  respiratoryRate   Int? // FR (rpm)
  temperature       Decimal? @db.Decimal(4, 1) // Tº (°C)
  oxygenSat         Int? // SatO2 (%)
  weight            Decimal? @db.Decimal(5, 2) // peso (kg)
  height            Decimal? @db.Decimal(5, 2) // talla (cm)
  bmi               Decimal? @db.Decimal(5, 2) // IMC (calculado)
  calfCircumference Decimal? @db.Decimal(5, 2) // circunferencia de pantorrilla (cm)
  bloodGlucose      Int? // glicemia capilar (mg/dL)
  gripStrength      Decimal? @db.Decimal(5, 2) // fuerza de agarre / dinamómetro (kg)
  notes             String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  createdBy   User?     @relation("VitalSignCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([patientId, deletedAt, measuredAt])
  @@index([consultationId])
  @@index([createdById])
}

// ─────────────────────────────────────────────────────────────────────────
// Medicación (polifarmacia) — Fase 4
// ─────────────────────────────────────────────────────────────────────────

model Medication {
  id String @id @default(cuid())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  drug         String // fármaco
  dose         String? // dosis (ej. "10 mg")
  frequency    String? // frecuencia (ej. "cada 8 h")
  route        MedicationRoute?
  startDate    DateTime? // fecha de inicio
  prescribedBy String? // indicado por

  status          MedicationStatus @default(ACTIVA)
  suspendedAt     DateTime? // fecha de suspensión
  suspendedReason String? // motivo de suspensión

  // Alerta/interacción marcada manualmente (se resalta en la conciliación).
  alertNote String?
  notes     String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  createdBy   User?     @relation("MedicationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([patientId, deletedAt, status])
  @@index([createdById])
}

// ─────────────────────────────────────────────────────────────────────────
// Documentos y estudios (Fase 5)
// ─────────────────────────────────────────────────────────────────────────

model Document {
  id String @id @default(cuid())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  title     String
  category  DocumentCategory @default(OTRO)
  studyDate DateTime? // fecha de realización del estudio

  // Metadatos del archivo. storedPath es relativo a STORAGE_DIR.
  fileName  String // nombre original
  storedPath String // ruta relativa en el almacenamiento
  mimeType  String
  size      Int // bytes (acotado por MAX_UPLOAD_MB, muy por debajo de 2 GB)

  notes String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  createdBy   User?     @relation("DocumentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([patientId, deletedAt, studyDate])
  @@index([category])
  @@index([createdById])
}

// ─────────────────────────────────────────────────────────────────────────
// Escalas de valoración geriátrica (Fase 6)
// ─────────────────────────────────────────────────────────────────────────

model AssessmentScale {
  id String @id @default(cuid())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  type           String // BARTHEL, LAWTON, MMSE, YESAVAGE, ... (sin enum: extensible)
  score          Int
  maxScore       Int
  appliedAt      DateTime @default(now())
  answers        Json // respuestas individuales { questionId: value }
  interpretation String?
  notes          String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  createdBy   User?     @relation("AssessmentScaleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([patientId, deletedAt, type, appliedAt])
  @@index([type])
  @@index([createdById])
}

// Evaluación de síndromes geriátricos: foto fechada con los síndromes
// presentes ese día (la más reciente = estado actual del paciente).
model SyndromeAssessment {
  id String @id @default(cuid())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  assessedAt DateTime @default(now())
  present    Json // claves de síndromes presentes: string[]
  gdsStage   Int? // estadio GDS-FAST (1–7), opcional
  notes      String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  createdBy   User?     @relation("SyndromeAssessmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([patientId, deletedAt, assessedAt])
  @@index([createdById])
}

// Evaluación de lenguaje/cognición con láminas: nominación de imágenes,
// repetición de frases y descripción de escena.
model LanguageAssessment {
  id String @id @default(cuid())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  assessedAt       DateTime @default(now())
  naming           Json // acierto por objeto: boolean[]
  phrases          Json // acierto por frase: boolean[]
  descriptionNotes String?  @db.Text
  notes            String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  createdBy   User?     @relation("LanguageAssessmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([patientId, deletedAt, assessedAt])
  @@index([createdById])
}

// ─────────────────────────────────────────────────────────────────────────
// Vacunación y plan de cuidados (Fase 8)
// ─────────────────────────────────────────────────────────────────────────

model Vaccination {
  id String @id @default(cuid())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  vaccine      String // nombre de la vacuna
  doseDate     DateTime? // fecha de aplicación
  nextDoseDate DateTime? // próxima dosis
  notes        String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  createdBy   User?     @relation("VaccinationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([patientId, deletedAt, doseDate])
  @@index([nextDoseDate])
  @@index([createdById])
}

// Plan de cuidados activo (uno por paciente).
model CarePlan {
  id String @id @default(cuid())

  patientId String  @unique
  patient   Patient @relation(fields: [patientId], references: [id])

  objectives      String?   @db.Text
  indications     String?   @db.Text
  nextControls    String?   @db.Text
  nextControlDate DateTime? // próximo control (para alertas)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  createdBy   User?     @relation("CarePlanCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([nextControlDate])
  @@index([createdById])
}

// ─────────────────────────────────────────────────────────────────────────
// Auditoría
// ─────────────────────────────────────────────────────────────────────────

model AuditLog {
  id String @id @default(cuid())

  // Quién (puede ser null en intentos de login con email inexistente).
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // Qué pasó: acción + recurso afectado.
  action   String // ej. "login.success", "login.failed", "user.update"
  resource String? // ej. "patient", "user"
  resourceId String?

  // Contexto adicional (cambios, email intentado, etc.) como JSON.
  metadata Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  // "Historial de este recurso": la consulta natural al investigar un incidente.
  @@index([resource, resourceId, createdAt])
}
