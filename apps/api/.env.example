# ─── Backend (apps/api) ───────────────────────────────────────────────────
# Copiá este archivo a `.env` y ajustá los valores. NUNCA versiones `.env`.

# Conexión a PostgreSQL. El operador define esta cadena en producción.
DATABASE_URL="postgresql://USUARIO:CONTRASENA@localhost:5432/geriatria?schema=public"

# Puerto donde escucha la API.
PORT=3027

# Entorno: development | production | test
NODE_ENV=development

# Zona horaria del proceso. La app resuelve las fechas de la agenda en la zona
# de la clínica (America/Asuncion) sin depender de esta variable, pero conviene
# alinearla para que los logs y el SO coincidan.
TZ=America/Asuncion

# Secreto para firmar los JWT. Mínimo 32 caracteres. GENERÁ UNO PROPIO:
#   openssl rand -base64 48
# Nunca uses este valor de ejemplo.
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio-de-al-menos-32"

# Vigencia del token de sesión.
JWT_EXPIRES_IN="8h"

# Flag Secure de la cookie de sesión. Si se omite, se deduce del entorno
# (true en producción). Poné true cuando sirvas por HTTPS.
COOKIE_SECURE=false

# Confiar en la cabecera X-Forwarded-For. Activalo SOLO si hay un reverse proxy
# delante: con true y sin proxy, cualquiera puede falsear su IP y saltarse el
# rate limit o envenenar el registro de auditoría.
TRUST_PROXY=false

# Dominio del frontend permitido por CORS (separar varios con coma).
CORS_ORIGIN="http://localhost:3028"

# Almacenamiento de documentos clínicos (archivos subidos).
# Ruta en disco; el operador puede apuntarla a un volumen persistente.
STORAGE_DIR="./storage"
# Tamaño máximo por archivo subido, en MB.
MAX_UPLOAD_MB=25

# ─── Seed del administrador inicial ─────────────────────────────────────────
# Credenciales del primer usuario Administrador que crea `pnpm db:seed`.
# ADMIN_PASSWORD no tiene valor por defecto a propósito: una contraseña de
# administrador conocida da acceso total a la historia clínica de todos los
# pacientes. Mínimo 12 caracteres; el seed falla si no la definís.
ADMIN_EMAIL="admin@geriatria.local"
ADMIN_PASSWORD=""
ADMIN_NAME="Administrador"
